  "viewport": [
    1440,
    900
  ],
  "scrollY": 0,
  "devicePixelRatio": 1,
  "libs": [
    "css scroll-driven animations"
  ],
  "fonts": [
    "GeistSans 100 900 normal",
    "GeistSans Fallback normal normal",
    "GeistMono 100 900 normal"
  ],
  "canvases": [],
  "target": null,
  "animations": [],
  "keyframes": [
    {
      "name": "spinner-opacity",
      "css": "@keyframes spinner-opacity { \n  0% { opacity: 1; }\n  100% { opacity: 0.15; }\n}"
    },
    {
      "name": "geistdocs-sidebar-fade-top",
      "css": "@keyframes geistdocs-sidebar-fade-top { \n  100% { --geistdocs-sidebar-fade-top: var(--geistdocs-sidebar-fade-size); }\n}"
    },
    {
      "name": "geistdocs-sidebar-fade-bottom",
      "css": "@keyframes geistdocs-sidebar-fade-bottom { \n  0% { --geistdocs-sidebar-fade-bottom: var(--geistdocs-sidebar-fade-size); }\n}"
    },
    {
      "name": "spin",
      "css": "@keyframes spin { \n  100% { transform: rotate(360deg); }\n}"
    },
    {
      "name": "pulse",
      "css": "@keyframes pulse { \n  50% { opacity: 0.5; }\n}"
    },
    {
      "name": "fd-sidebar-in",
      "css": "@keyframes fd-sidebar-in { \n  0% { transform: translateX(var(--fd-sidebar-drawer-offset)); }\n}"
    },
    {
      "name": "fd-sidebar-out",
      "css": "@keyframes fd-sidebar-out { \n  100% { transform: translateX(var(--fd-sidebar-drawer-offset)); }\n}"
    },
    {
      "name": "fd-collapsible-down",
      "css": "@keyframes fd-collapsible-down { \n  0% { opacity: 0; height: 0px; }\n  100% { height: var(--radix-collapsible-content-height); }\n}"
    },
    {
      "name": "fd-collapsible-up",
      "css": "@keyframes fd-collapsible-up { \n  0% { height: var(--radix-collapsible-content-height); }\n  100% { opacity: 0; height: 0px; }\n}"
    },
    {
      "name": "fd-accordion-down",
      "css": "@keyframes fd-accordion-down { \n  0% { opacity: 0.5; height: 0px; }\n  100% { height: var(--radix-accordion-content-height); }\n}"
    },
    {
      "name": "fd-accordion-up",
      "css": "@keyframes fd-accordion-up { \n  0% { height: var(--radix-accordion-content-height); }\n  100% { opacity: 0.5; height: 0px; }\n}"
    },
    {
      "name": "fd-dialog-in",
      "css": "@keyframes fd-dialog-in { \n  0% { opacity: 0; transform: scale(1.06); }\n  100% { transform: scale(1); }\n}"
    },
    {
      "name": "fd-dialog-out",
      "css": "@keyframes fd-dialog-out { \n  0% { transform: scale(1); }\n  100% { opacity: 0; transform: scale(1.04); }\n}"
    },
    {
      "name": "fd-popover-in",
      "css": "@keyframes fd-popover-in { \n  0% { opacity: 0; transform: scale(0.9); }\n}"
    },
    {
      "name": "fd-popover-out",
      "css": "@keyframes fd-popover-out { \n  100% { opacity: 0; transform: scale(0.9); }\n}"
    },
    {
      "name": "fd-fade-in",
      "css": "@keyframes fd-fade-in { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
    },
    {
      "name": "fd-fade-out",
      "css": "@keyframes fd-fade-out { \n  0% { opacity: 1; }\n  100% { opacity: 0; }\n}"
    },
    {
      "name": "fd-enterFromRight",
      "css": "@keyframes fd-enterFromRight { \n  0% { opacity: 0; transform: translate(200px); }\n  100% { opacity: 1; transform: translate(0px); }\n}"
    },
    {
      "name": "fd-enterFromLeft",
      "css": "@keyframes fd-enterFromLeft { \n  0% { opacity: 0; transform: translate(-200px); }\n  100% { opacity: 1; transform: translate(0px); }\n}"
    },
    {
      "name": "fd-exitToRight",
      "css": "@keyframes fd-exitToRight { \n  0% { opacity: 1; transform: translate(0px); }\n  100% { opacity: 0; transform: translate(200px); }\n}"
    },
    {
      "name": "fd-exitToLeft",
      "css": "@keyframes fd-exitToLeft { \n  0% { opacity: 1; transform: translate(0px); }\n  100% { opacity: 0; transform: translate(-200px); }\n}"
    },
    {
      "name": "fd-nav-menu-in",
      "css": "@keyframes fd-nav-menu-in { \n  0% { opacity: 0; height: 0px; }\n  100% { opacity: 1; height: var(--radix-navigation-menu-viewport-height); }\n}"
    },
    {
      "name": "fd-nav-menu-out",
      "css": "@keyframes fd-nav-menu-out { \n  0% { opacity: 1; height: var(--radix-navigation-menu-viewport-height); }\n  100% { opacity: 0; height: 0px; }\n}"
    },
    {
      "name": "enter",
      "css": "@keyframes enter { \n  0% { opacity: var(--tw-enter-opacity,1); transform: translate3d(var(--tw-enter-translate-x,0),var(--tw-enter-translate-y,0),0)scale3d(var(--tw-enter-scale,1),var(--tw-enter-scale,1),var(--tw-enter-scale,1))rotate(var(--tw-enter-rotate,0)); filter: blur(var(--tw-enter-blur,0)); }\n}"
    },
    {
      "name": "exit",
      "css": "@keyframes exit { \n  100% { opacity: var(--tw-exit-opacity,1); transform: translate3d(var(--tw-exit-translate-x,0),var(--tw-exit-translate-y,0),0)scale3d(var(--tw-exit-scale,1),var(--tw-exit-scale,1),var(--tw-exit-scale,1))rotate(var(--tw-exit-rotate,0)); filter: blur(var(--tw-exit-blur,0)); }\n}"
    }
