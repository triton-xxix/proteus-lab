Why (Smith, 16 Nov 2026): P-0154 and P-0156 (14 Oct) each lost a call to the hook denying
`node --test` and `npm --prefix sandbox/x test`, and both worked round with a runner script. This
allows node's own test runner on named, absolute test-file paths under sandbox/ (a child may too,
its scripts live there already). A bare `node --test` stays off because it globs the working
directory, and so does any flag after --test. `npm test` stays off on purpose: it runs whatever
string package.json holds, which would step round every shell rule here. Test cases ride in the
same diff. Apply in an interactive session, then run bin/test-hook.py.

--- a/.claude/hooks/unattended-decide.py
+++ b/.claude/hooks/unattended-decide.py
@@ -529,6 +529,13 @@
                 parts = [head] + parts[2:]
             if head == "node" and len(parts) == 2 and parts[1] in ("--version", "-v"):
                 continue
+            # F-0023 (16 Nov 2026): node's own test runner, on named test files under sandbox/ only. A bare
+            # --test globs the working directory, so it stays off; so does npm test, which runs whatever
+            # string package.json holds. Both cost P-0154 and P-0156 a denied call (14 Oct).
+            if head == "node" and len(parts) > 2 and parts[1] == "--test":
+                if all(not p.startswith("-") and _under(p, SANDBOX) for p in parts[2:]):
+                    continue
+                return "node --test is allowed only on absolute test-file paths under %s." % SANDBOX
             if len(parts) > 1 and _under_root(parts[1]):
                 continue
             if head == "node" and len(parts) > 1 and parts[1] == "-e":
@@ -719,6 +726,8 @@
             parts = [head] + parts[2:]
         if head == "node" and len(parts) > 2 and parts[1] == "--experimental-strip-types":
             parts = [head] + parts[2:]
+        if head == "node" and len(parts) > 2 and parts[1] == "--test":
+            parts = [head] + parts[2:]
         if _under_root(head):
             script = head
         elif head in ("node", "bash", "sh", "python3", "python", VENV_PY, VENV_PY_ALT) and len(parts) > 1 and _under_root(parts[1]):
